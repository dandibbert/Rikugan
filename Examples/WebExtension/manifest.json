{
  "manifest_version": 3,
  "name": "Rikugan Demo",
  "version": "1.0.0",
  "description": "Tests content scripts, background messaging, storage.local, tabs.query, scripting and notifications.",
  "permissions": ["storage", "tabs", "scripting", "notifications"],
  "host_permissions": ["https://example.com/*", "http://127.0.0.1/*"],
  "background": {"scripts": ["background.js"], "persistent": false, "preferred_environment": ["document"], "service_worker": "background.js"},
  "action": {"default_title": "Rikugan Demo", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://example.com/*", "http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end"}]
}
